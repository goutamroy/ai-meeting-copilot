# =========================
# OpenAI
# =========================
OPENAI_API_KEY=your_openai_key

# =========================
# Azure Blob
# =========================
AZURE_STORAGE_CONNECTION_STRING=your_azure_blob_connection_string
AZURE_CONTAINER_NAME=meeting-files

# =========================
# Pinecone
# =========================
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_NAME=meeting-index

# =========================
# PostgreSQL
# =========================
DATABASE_URL=postgresql://username:password@localhost:5432/ai_meeting_copilot

# =========================
# Upload limits
# =========================
MAX_UPLOAD_SIZE=10485760